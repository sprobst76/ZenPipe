<?xml version="1.0" encoding="utf-8"?>
<!-- ZenPipe: keep the Zen state out of cloud backup and device transfer (Android 12+). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="zen_state.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="zen_state.xml" />
    </device-transfer>
</data-extraction-rules>
